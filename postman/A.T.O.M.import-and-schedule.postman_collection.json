        {
          "name": "3.5 Get My Instructor Schedule Grid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('instructor grid ok', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "var fullName = pm.collectionVariables.get('profileFullName');",
                  "pm.test('instructor grid has arrays', function () {",
                  "    pm.expect(Array.isArray(json.dates)).to.eql(true);",
                  "    pm.expect(Array.isArray(json.groups)).to.eql(true);",
                  "});",
                  "var hasOwnLesson = false;",
                  "(json.groups || []).forEach(function (group) {",
                  "    (group.days || []).forEach(function (day) {",
                  "        (day.lessons || []).forEach(function (lesson) {",
                  "            if ((lesson.instructorNames || []).indexOf(fullName) >= 0) { hasOwnLesson = true; }",
                  "        });",
                  "    });",
                  "});",
                  "pm.test('grid contains at least one lesson for current instructor', function () {",
                  "    pm.expect(hasOwnLesson).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{instructorUser}}", "type": "string" },
