                "exec": [
                  "pm.test('profile update ok', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('profile fields saved', function () {",
                  "    pm.expect(json.fullName).to.eql(pm.collectionVariables.get('profileFullName'));",
                  "    pm.expect(json.email).to.eql(pm.collectionVariables.get('profileEmail'));",
                  "    pm.expect(json.phone).to.eql(pm.collectionVariables.get('profilePhone'));",
                  "    pm.expect(json.position).to.eql(pm.collectionVariables.get('profilePosition'));",
                  "    pm.expect(json.department).to.eql(pm.collectionVariables.get('profileDepartment'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "basic",
              "basic": [
