              "raw": "{{baseUrl}}/api/me/notifications?from={{cabinetFrom}}&to={{cabinetTo}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "notifications"],
              "query": [
                { "key": "from", "value": "{{cabinetFrom}}" },
                { "key": "to", "value": "{{cabinetTo}}" }
              ]
            }
          }
        },
        {
          "name": "3.8 Get My Dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('dashboard ok', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('dashboard contains all main blocks', function () {",
                  "    pm.expect(json.profile).to.be.an('object');",
                  "    pm.expect(json.instructorSchedule).to.be.an('object');",
                  "    pm.expect(json.workload).to.be.an('object');",
                  "    pm.expect(Array.isArray(json.notifications)).to.eql(true);",
                  "});",
                  "pm.test('dashboard profile matches current instructor', function () {",
                  "    pm.expect(json.profile.username).to.eql(pm.collectionVariables.get('instructorUser'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{instructorUser}}", "type": "string" },
                { "key": "password", "value": "{{instructorPass}}", "type": "string" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/me/dashboard?from={{cabinetFrom}}&to={{cabinetTo}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "dashboard"],
              "query": [
                { "key": "from", "value": "{{cabinetFrom}}" },
                { "key": "to", "value": "{{cabinetTo}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Password Flow",
      "description": "Optional pair. Run both requests in sequence so password is changed and then rolled back.",
      "item": [
        {
          "name": "4.1 Change My Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('password change accepted', function () { pm.expect([200, 204]).to.include(pm.response.code); });",
                  "pm.collectionVariables.set('instructorPass', pm.collectionVariables.get('tempInstructorPass'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{instructorUser}}", "type": "string" },
                { "key": "password", "value": "{{instructorPass}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"instructor123\",\n  \"newPassword\": \"{{tempInstructorPass}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/me/password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "password"]
            }
          }
        },
        {
          "name": "4.2 Get My Profile With New Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('new password works', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('still same instructor', function () { pm.expect(json.username).to.eql(pm.collectionVariables.get('instructorUser')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{instructorUser}}", "type": "string" },
                { "key": "password", "value": "{{instructorPass}}", "type": "string" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/me/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "profile"]
            }
          }
        },
        {
          "name": "4.3 Change Password Back",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('password rollback accepted', function () { pm.expect([200, 204]).to.include(pm.response.code); });",
                  "pm.collectionVariables.set('instructorPass', 'instructor123');"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{instructorUser}}", "type": "string" },
                { "key": "password", "value": "{{instructorPass}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{tempInstructorPass}}\",\n  \"newPassword\": \"instructor123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/me/password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "password"]
            }
          }
        }
      ]
    }
  ]
