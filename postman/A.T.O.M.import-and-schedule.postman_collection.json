  "item": [
    {
      "name": "1. Public And Import",
      "description": "Import test data and check public schedule endpoints.",
      "item": [
        {
          "name": "1.1 Import CSV",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('import ok', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('csv import result looks sane', function () {",
                  "    pm.expect(json.status).to.eql('ok');",
                  "    pm.expect(json.source).to.eql('csv');",
                  "    pm.expect(json.importedGroups).to.be.a('number');",
                  "    pm.expect(json.importedGroups).to.be.above(0);",
                  "    pm.expect(json.performedBy).to.eql(pm.collectionVariables.get('adminUser'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminUser}}", "type": "string" },
                { "key": "password", "value": "{{adminPass}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "{{csvFilePath}}" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/import/csv",
              "host": ["{{baseUrl}}"],
              "path": ["api", "import", "csv"]
            }
          }
        },
        {
          "name": "1.2 Public Schedule By Group",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('public group schedule ok', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "var groupCode = pm.collectionVariables.get('groupCode');",
                  "pm.test('response is non-empty array', function () {",
                  "    pm.expect(Array.isArray(json)).to.eql(true);",
                  "    pm.expect(json.length).to.be.above(0);",
                  "});",
                  "pm.test('all entries belong to chosen group', function () {",
                  "    json.forEach(function (item) { pm.expect(item.groupCode).to.eql(groupCode); });",
                  "});",
                  "if (json[0] && json[0].lessonId) { pm.collectionVariables.set('lessonId', json[0].lessonId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/public/schedule?groupCode={{groupCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "schedule"],
              "query": [
                { "key": "groupCode", "value": "{{groupCode}}" }
              ]
            }
          }
        },
        {
          "name": "1.3 Public Schedule By Group And Day",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('public day schedule ok', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "var groupCode = pm.collectionVariables.get('groupCode');",
                  "var day = pm.collectionVariables.get('dayFrom');",
                  "pm.test('response is array', function () { pm.expect(Array.isArray(json)).to.eql(true); });",
                  "pm.test('entries belong to chosen day and group', function () {",
                  "    json.forEach(function (item) {",
                  "        pm.expect(item.groupCode).to.eql(groupCode);",
                  "        pm.expect(item.date).to.eql(day);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/public/schedule?groupCode={{groupCode}}&from={{dayFrom}}&to={{dayTo}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "schedule"],
              "query": [
                { "key": "groupCode", "value": "{{groupCode}}" },
                { "key": "from", "value": "{{dayFrom}}" },
                { "key": "to", "value": "{{dayTo}}" }
              ]
            }
          }
        }
      ]
    },
